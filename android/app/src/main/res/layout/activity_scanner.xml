<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
 <com.journeyapps.barcodescanner.DecoratedBarcodeView android:id="@+id/zxing_barcode_scanner" android:layout_width="match_parent" android:layout_height="match_parent" />
 <LinearLayout android:id="@+id/scanner_controls" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="22dp" android:gravity="center_horizontal">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
   <ImageButton android:id="@+id/close_scanner" android:layout_width="46dp" android:layout_height="46dp" android:src="@drawable/ic_close" android:contentDescription="Close scanner" android:padding="13dp" android:background="@drawable/scanner_button" android:tint="#F4F4ED" />
   <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GLIDE / PAIR" android:textColor="#D9FF55" android:textStyle="bold" android:textSize="12sp" android:letterSpacing="0.16" />
  </LinearLayout>
  <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="22dp" android:background="@drawable/scanner_sheet">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Find your PC" android:textColor="#F4F4ED" android:textStyle="bold" android:textSize="24sp" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Point the camera at the Glide code on your desktop. Pairing happens instantly." android:textColor="#A3A69A" android:textSize="13sp" android:gravity="center" android:lineSpacingMultiplier="1.15" android:layout_marginTop="8dp" android:layout_marginBottom="18dp" />
   <TextView android:id="@+id/torch" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:text="FLASH  OFF" android:textStyle="bold" android:textSize="12sp" android:letterSpacing="0.12" android:textColor="#171815" android:background="@drawable/scanner_action" />
  </LinearLayout>
 </LinearLayout>
</FrameLayout>
